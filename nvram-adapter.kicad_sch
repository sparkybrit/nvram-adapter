	(text "U2 passes ~{ROMCE} to the SRAM (1.5-7 ns) while +5V is above 4.50-4.75 V,\nand holds ~{CE_RAM} high (at VRAM) below it: the same write protection as the\nDS1250AB (4.50-4.75 V). Below the threshold and below VBAT, VRAM switches\nto the cell. ~{MR} has an internal 20k pull-up and is left open.\nCE2 is tied to VRAM, so ~{CE_RAM} alone selects the chip."
		(exclude_from_sim no)
		(at 177.8 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bdfd2e19-9893-5ce4-90b5-a2a6cb854fb5")
	)
	(text "J1 and J2 match rom-ram-breadboard-adapter pin for pin,\nwith the names on its silkscreen. Only the ROM strobes are used:\n~{RAMCE}, ~{RAMOE} and ~{RAMWE} (its unfitted U2) go nowhere here."
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fa3f8ccd-af07-5bae-b3ec-10126c5fffae")
	)
